<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Foot_Tracker.ViewModels"
        xmlns:conv="using:Foot_Tracker.Converters"
        x:Class="Foot_Tracker.Views.PreviouslyBattledUsersWindow"
        x:DataType="vm:PreviouslyBattledUsersViewModel"
        Title="Previously Battled Users"
        Width="520" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackgroundBrush}"
        BorderBrush="{DynamicResource ThemeBorderBrush}"
        BorderThickness="1">

    <!-- §188: the content sits on a themedPanel so it reads off a surface
         rather than off the background image. The panel follows the Stats
         Background colour and is invisible until that colour is set - no
         fill, no outline, no inset. Its child is deliberately not
         re-indented. See App.axaml. -->
    <Window.Styles>
        <!-- §276: §220's header chip, the same one the encounter history and
             the main window's tables use - the columns had no labels at all
             until now, which left a bare number and a date to be guessed at. -->
        <Style Selector="Border.tableHeader">
            <Setter Property="Background" Value="{DynamicResource ThemeTableHeaderBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style Selector="Border.tableHeader > TextBlock">
            <Setter Property="Margin" Value="6,5" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
        </Style>
    </Window.Styles>

    <Border Classes="themedPanel">
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">

        <TextBlock Grid.Row="0" Text="Previously Battled Users" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource ThemeTextBrush}" Margin="0,0,0,4" />

        <TextBlock Grid.Row="1"
                   Text="Every PVP battle automatically detected, most recent first - rebattling the same opponent adds a new entry (keeps the 250 most recent battles). Click a name for that opponent's full history."
                   TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,0,0,12" />

        <!-- §276: the column labels. The row template below repeats these
             ColumnDefinitions verbatim - the two have to stay in step by
             hand, the same as the encounter history's two tables. -->
        <Grid Grid.Row="2" ColumnDefinitions="*,78,64,124" Margin="0,0,0,4">
            <Border Grid.Column="0" Classes="tableHeader"><TextBlock Text="Name" /></Border>
            <Border Grid.Column="1" Classes="tableHeader"><TextBlock Text="Result" /></Border>
            <Border Grid.Column="2" Classes="tableHeader"><TextBlock Text="Faced" /></Border>
            <Border Grid.Column="3" Classes="tableHeader"><TextBlock Text="When" /></Border>
        </Grid>

        <ScrollViewer Grid.Row="3">
            <StackPanel>
                <TextBlock Text="No PVP battles detected yet."
                           Foreground="{DynamicResource ThemeTextBrush}"
                           IsVisible="{Binding HasNoOpponents}" Margin="0,8,0,0" />

                <ItemsControl ItemsSource="{Binding Opponents}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PvpOpponentDisplayItem">
                            <!-- §276: the whole row is the hit target, not just
                                 the name - a name is a short word and a row is
                                 easy to aim at. -->
                            <Border Cursor="Hand" Background="Transparent" Padding="0,4"
                                    ToolTip.Tip="Open this opponent's full history"
                                    PointerPressed="OpponentRow_PointerPressed">
                                <Grid ColumnDefinitions="*,78,64,124">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Margin="6,0"
                                               Foreground="{DynamicResource ThemeTextBrush}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Panel Grid.Column="1">
                                        <TextBlock Text="Won" Foreground="#4CAF50" FontWeight="Bold"
                                                   TextAlignment="Center" VerticalAlignment="Center"
                                                   IsVisible="{Binding IsWin}" />
                                        <TextBlock Text="Lost" Foreground="#E05252" FontWeight="Bold"
                                                   TextAlignment="Center" VerticalAlignment="Center"
                                                   IsVisible="{Binding IsLoss}" />
                                        <TextBlock Text="-" Opacity="0.6" TextAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ThemeTextBrush}"
                                                   IsVisible="{Binding IsUnknownResult}"
                                                   ToolTip.Tip="The result was never read - the battle window went away before PRO printed one." />
                                    </Panel>
                                    <TextBlock Grid.Column="2" Text="{Binding TimesBattledDisplay}"
                                               Foreground="{DynamicResource ThemeTextBrush}"
                                               TextAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding BattledAt}"
                                               Foreground="{DynamicResource ThemeTextBrush}"
                                               TextAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="4" Text="{Binding ExportStatusMessage}"
                   Foreground="{DynamicResource ThemeTextBrush}" TextWrapping="Wrap"
                   IsVisible="{Binding ExportStatusMessage, Converter={x:Static conv:StringNotEmptyConverter.Instance}}"
                   Margin="0,8,0,0" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" Margin="0,12,0,0">
            <Button Content="Remove Previous" Command="{Binding RemovePreviousCommand}" IsEnabled="{Binding HasOpponents}" />
            <Button Content="Clear All" Command="{Binding ClearAllCommand}" IsEnabled="{Binding HasOpponents}" />
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Export…" Command="{Binding ExportCommand}" />
            <Button Content="Close" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
    </Border>
</Window>
