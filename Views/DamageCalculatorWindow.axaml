<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Foot_Tracker.ViewModels"
        xmlns:conv="using:Foot_Tracker.Converters"
        x:Class="Foot_Tracker.Views.DamageCalculatorWindow"
        x:DataType="vm:DamageCalculatorViewModel"
        Title="Damage Calculator"
        Width="1010" Height="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackgroundBrush}"
        BorderBrush="{DynamicResource ThemeBorderBrush}"
        BorderThickness="1">

    <!-- §188: the content sits on a themedPanel so it reads off a surface
         rather than off the background image. The panel follows the Stats
         Background colour and is invisible until that colour is set - no
         fill, no outline, no inset. Its child is deliberately not
         re-indented. See App.axaml. -->
    <Border Classes="themedPanel">
    <Grid Margin="16" RowDefinitions="Auto,*,Auto">

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Damage Calculator" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource ThemeTextBrush}" />
            <TextBlock Text="Damage shows as a min-max range because the game rolls 85-100% on every hit. Pick both Pokémon and a move, adjust anything, then press Calculate."
                       TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                       Foreground="{DynamicResource ThemeTextBrush}" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Classic three-column damage-calculator shape: attacker | move+results | defender.
             The whole middle row scrolls as one piece so smaller screens still reach
             everything (the panels are sized to fit 760 tall without it). -->
        <ScrollViewer Grid.Row="1">
            <Grid ColumnDefinitions="*,320,*">

                <!-- ============ Attacker ============ -->
                <Border Grid.Column="0" BorderBrush="{DynamicResource ThemeBorderBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="10">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Attacker" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemeTextBrush}" />

                        <TextBox Text="{Binding AttackerSearchText}" PlaceholderText="Search Pokémon..." />
                        <ListBox Height="130" ItemsSource="{Binding AttackerNames}"
                                 SelectedItem="{Binding SelectedAttackerName, Mode=TwoWay}" />

                        <TextBlock Text="{Binding AttackerTypesLine}" FontSize="11" Opacity="0.7"
                                   Foreground="{DynamicResource ThemeTextBrush}" />
                        <TextBlock Text="{Binding AttackerBaseLine}" FontSize="11" Opacity="0.7"
                                   TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextBrush}" />

                        <Grid ColumnDefinitions="92,*">
                            <TextBlock Grid.Column="0" Text="Level" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ThemeTextBrush}" />
                            <TextBox Grid.Column="1" Width="64" MinWidth="0" HorizontalAlignment="Left"
                                     Text="{Binding AttackerLevelText}" />
                        </Grid>

                        <Grid ColumnDefinitions="92,*">
                            <TextBlock Grid.Column="0" Text="Nature" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ThemeTextBrush}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding NatureOptions}"
                                      SelectedItem="{Binding SelectedAttackerNature, Mode=TwoWay}" />
                        </Grid>

                        <!-- Six IVs over six EVs, one thin column per stat -->
                        <Grid ColumnDefinitions="26,*,*,*,*,*,*" RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="HP" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Atk" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Def" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="SpA" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="5" Text="SpD" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="6" Text="Spe" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextBrush}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="IV" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextBrush}" />
                            <TextBox Grid.Row="1" Grid.Column="1" MinWidth="0" Margin="1" Text="{Binding AttackerIvHpText}" />
                            <TextBox Grid.Row="1" Grid.Column="2" MinWidth="0" Margin="1" Text="{Binding AttackerIvAttackText}" />
                            <TextBox Grid.Row="1" Grid.Column="3" MinWidth="0" Margin="1" Text="{Binding AttackerIvDefenseText}" />
                            <TextBox Grid.Row="1" Grid.Column="4" MinWidth="0" Margin="1" Text="{Binding AttackerIvSpAttackText}" />
                            <TextBox Grid.Row="1" Grid.Column="5" MinWidth="0" Margin="1" Text="{Binding AttackerIvSpDefenseText}" />
                            <TextBox Grid.Row="1" Grid.Column="6" MinWidth="0" Margin="1" Text="{Binding AttackerIvSpeedText}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="EV" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextBrush}" />
                            <TextBox Grid.Row="2" Grid.Column="1" MinWidth="0" Margin="1" Text="{Binding AttackerEvHpText}" />
                            <TextBox Grid.Row="2" Grid.Column="2" MinWidth="0" Margin="1" Text="{Binding AttackerEvAttackText}" />
                            <TextBox Grid.Row="2" Grid.Column="3" MinWidth="0" Margin="1" Text="{Binding AttackerEvDefenseText}" />
                            <TextBox Grid.Row="2" Grid.Column="4" MinWidth="0" Margin="1" Text="{Binding AttackerEvSpAttackText}" />
                            <TextBox Grid.Row="2" Grid.Column="5" MinWidth="0" Margin="1" Text="{Binding AttackerEvSpDefenseText}" />
                            <TextBox Grid.Row="2" Grid.Column="6" MinWidth="0" Margin="1" Text="{Binding AttackerEvSpeedText}" />
                        </Grid>

                        <Grid ColumnDefinitions="92,*">
                            <TextBlock Grid.Column="0" Text="Attack stage" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ThemeTextBrush}" />
                            <ComboBox Grid.Column="1" Width="80" HorizontalAlignment="Left"
                                      ItemsSource="{Binding StageOptions}"
                                      SelectedItem="{Binding SelectedAttackStage, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="92,*">
                            <TextBlock Grid.Column="0" Text="Item" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ThemeTextBrush}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AttackerItemOptions}"
                                      SelectedItem="{Binding SelectedAttackerItem, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="92,*">
                            <TextBlock Grid.Column="0" Text="Ability" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ThemeTextBrush}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AttackerAbilityOptions}"
                                      SelectedItem="{Binding SelectedAttackerAbility, Mode=TwoWay}" />
                        </Grid>

                        <CheckBox Content="Burned (halves physical damage)" IsChecked="{Binding AttackerBurned}" />
                    </StackPanel>
                </Border>

                <!-- ============ Move, field and results ============ -->
                <Border Grid.Column="1" Margin="10,0" BorderBrush="{DynamicResource ThemeBorderBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="10">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Move" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemeTextBrush}" />

                        <TextBox Text="{Binding MoveSearchText}" PlaceholderText="Search moves..." />
                        <CheckBox Content="Only damaging moves" IsChecked="{Binding OnlyDamagingMoves}" />
                        <CheckBox Content="Only moves the attacker learns" IsChecked="{Binding OnlyLearnsetMoves}" />
                        <ListBox Height="120" ItemsSource="{Binding MoveNames}"
                                 SelectedItem="{Binding SelectedMoveName, Mode=TwoWay}" />

                        <TextBlock Text="{Binding MoveInfoLine}" FontSize="11" Opacity="0.7"
                                   TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextBrush}" />

                        <Grid ColumnDefinitions="92,*">
                            <TextBlock Grid.Column="0" Text="Power" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ThemeTextBrush}" />
                            <TextBox Grid.Column="1" Width="64" MinWidth="0" HorizontalAlignment="Left"
                                     Text="{Binding MovePowerText}" />
                        </Grid>

                        <Grid ColumnDefinitions="92,*">
                            <TextBlock Grid.Column="0" Text="Weather" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ThemeTextBrush}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding WeatherChoices}"
                                      SelectedItem="{Binding SelectedWeather, Mode=TwoWay}" />
                        </Grid>

                        <Button Content="Calculate" Command="{Binding CalculateCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                FontWeight="Bold" Margin="0,4,0,0" />

                        <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="8" Margin="0,4,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding DamageRangeLine}" FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource ThemeTextBrush}" />
                                <TextBlock Text="{Binding PercentLine}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource ThemeTextBrush}" />
                                <TextBlock Text="{Binding KoLine}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource ThemeTextBrush}" />
                                <TextBlock Text="{Binding CritLine}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource ThemeTextBrush}" />
                                <TextBlock Text="{Binding EffectivenessLine}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource ThemeTextBrush}" />
                                <TextBlock Text="{Binding WeatherLine}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource ThemeTextBrush}" Opacity="0.85"
                                           IsVisible="{Binding WeatherLine, Converter={x:Static conv:StringNotEmptyConverter.Instance}}" />
                                <TextBlock Text="{Binding StatsLine}" FontSize="11" Opacity="0.7"
                                           TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ============ Defender ============ -->
                <Border Grid.Column="2" BorderBrush="{DynamicResource ThemeBorderBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="10">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Defender" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemeTextBrush}" />

                        <TextBox Text="{Binding DefenderSearchText}" PlaceholderText="Search Pokémon..." />
                        <ListBox Height="130" ItemsSource="{Binding DefenderNames}"
                                 SelectedItem="{Binding SelectedDefenderName, Mode=TwoWay}" />

                        <TextBlock Text="{Binding DefenderTypesLine}" FontSize="11" Opacity="0.7"
                                   Foreground="{DynamicResource ThemeTextBrush}" />
                        <TextBlock Text="{Binding DefenderBaseLine}" FontSize="11" Opacity="0.7"
                                   TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextBrush}" />

                        <Grid ColumnDefinitions="92,*">
                            <TextBlock Grid.Column="0" Text="Level" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ThemeTextBrush}" />
                            <TextBox Grid.Column="1" Width="64" MinWidth="0" HorizontalAlignment="Left"
                                     Text="{Binding DefenderLevelText}" />
                        </Grid>

                        <Grid ColumnDefinitions="92,*">
                            <TextBlock Grid.Column="0" Text="Nature" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ThemeTextBrush}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding NatureOptions}"
                                      SelectedItem="{Binding SelectedDefenderNature, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="26,*,*,*,*,*,*" RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="HP" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Atk" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Def" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="SpA" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="5" Text="SpD" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="6" Text="Spe" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextBrush}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="IV" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextBrush}" />
                            <TextBox Grid.Row="1" Grid.Column="1" MinWidth="0" Margin="1" Text="{Binding DefenderIvHpText}" />
                            <TextBox Grid.Row="1" Grid.Column="2" MinWidth="0" Margin="1" Text="{Binding DefenderIvAttackText}" />
                            <TextBox Grid.Row="1" Grid.Column="3" MinWidth="0" Margin="1" Text="{Binding DefenderIvDefenseText}" />
                            <TextBox Grid.Row="1" Grid.Column="4" MinWidth="0" Margin="1" Text="{Binding DefenderIvSpAttackText}" />
                            <TextBox Grid.Row="1" Grid.Column="5" MinWidth="0" Margin="1" Text="{Binding DefenderIvSpDefenseText}" />
                            <TextBox Grid.Row="1" Grid.Column="6" MinWidth="0" Margin="1" Text="{Binding DefenderIvSpeedText}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="EV" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextBrush}" />
                            <TextBox Grid.Row="2" Grid.Column="1" MinWidth="0" Margin="1" Text="{Binding DefenderEvHpText}" />
                            <TextBox Grid.Row="2" Grid.Column="2" MinWidth="0" Margin="1" Text="{Binding DefenderEvAttackText}" />
                            <TextBox Grid.Row="2" Grid.Column="3" MinWidth="0" Margin="1" Text="{Binding DefenderEvDefenseText}" />
                            <TextBox Grid.Row="2" Grid.Column="4" MinWidth="0" Margin="1" Text="{Binding DefenderEvSpAttackText}" />
                            <TextBox Grid.Row="2" Grid.Column="5" MinWidth="0" Margin="1" Text="{Binding DefenderEvSpDefenseText}" />
                            <TextBox Grid.Row="2" Grid.Column="6" MinWidth="0" Margin="1" Text="{Binding DefenderEvSpeedText}" />
                        </Grid>

                        <Grid ColumnDefinitions="92,*">
                            <TextBlock Grid.Column="0" Text="Defense stage" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ThemeTextBrush}" />
                            <ComboBox Grid.Column="1" Width="80" HorizontalAlignment="Left"
                                      ItemsSource="{Binding StageOptions}"
                                      SelectedItem="{Binding SelectedDefenseStage, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="92,*">
                            <TextBlock Grid.Column="0" Text="Ability" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ThemeTextBrush}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding DefenderAbilityOptions}"
                                      SelectedItem="{Binding SelectedDefenderAbility, Mode=TwoWay}" />
                        </Grid>

                        <CheckBox Content="At full HP (for Multiscale)" IsChecked="{Binding DefenderAtFullHp}" />
                        <CheckBox Content="Reflect / Light Screen up" IsChecked="{Binding ScreenUp}" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{DynamicResource ThemeErrorBrush}"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button Grid.Column="1" Content="Close" Click="CloseButton_Click" />
        </Grid>
    </Grid>
    </Border>
</Window>
