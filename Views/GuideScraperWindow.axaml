<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Foot_Tracker.ViewModels"
        x:Class="Foot_Tracker.Views.GuideScraperWindow"
        x:DataType="vm:GuideScraperViewModel"
        Title="Forum Guide Scraper (Admin)"
        Width="760" Height="700" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackgroundBrush}">

    <!-- §188: the content sits on a themedPanel so it reads off a surface
         rather than off the background image. The panel follows the Stats
         Background colour and is invisible until that colour is set - no
         fill, no outline, no inset. Its child is deliberately not
         re-indented. See App.axaml. -->
    <Border Classes="themedPanel">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" Margin="16" ColumnDefinitions="*">

        <TextBlock Grid.Row="0"
                   Text="Developer tool: reads the FIRST post of a pokemonrevolution.net forum topic and drafts DataFiles/Guides/{folder}/index.html from it. Images and tables are left out, and the result is a draft to edit rather than a finished guide. Nothing touches disk until Save is clicked, and a folder that already has a real index.html is never overwritten."
                   TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,0,0,12" />

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,0,0,8">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Topic:" VerticalAlignment="Center"
                       Margin="0,0,8,6" Foreground="{DynamicResource ThemeTextBrush}" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TopicUrl}" Margin="0,0,0,6"
                     PlaceholderText="https://pokemonrevolution.net/forum/topic/164725-.../" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Guide folder:" VerticalAlignment="Center"
                       Margin="0,0,8,6" Foreground="{DynamicResource ThemeTextBrush}" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding GuideFolderName}" Margin="0,0,0,6"
                     PlaceholderText="e.g. MegaStones - a plain folder name, no slashes" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Title:" VerticalAlignment="Center"
                       Margin="0,0,8,0" Foreground="{DynamicResource ThemeTextBrush}" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding GuideTitle}"
                     PlaceholderText="e.g. Mega Stones Guide" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button Content="Fetch &amp; Preview" Command="{Binding FetchCommand}" />
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{DynamicResource ThemeTextBrush}" />
        </StackPanel>

        <ItemsControl Grid.Row="3" ItemsSource="{Binding Warnings}" Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource ThemeWarningBrush}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="4" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Margin="0,0,0,8">
            <TextBox Text="{Binding PreviewHtml, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="NoWrap" FontFamily="Consolas,Menlo,monospace"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     Background="Transparent" BorderThickness="0" />
        </Border>

        <TextBlock Grid.Row="5"
                   Text="That folder already has an index.html with content in it. Saving writes index.scraped.html beside it instead, and leaves yours alone."
                   Foreground="{DynamicResource ThemeWarningBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                   IsVisible="{Binding TargetGuideExists}" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Save" Command="{Binding SaveCommand}" />
            <Button Content="Close" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
    </Border>
</Window>
