<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Foot_Tracker.ViewModels"
        x:Class="Foot_Tracker.Views.ExcludeStatsWindow"
        x:DataType="vm:ExcludeStatsViewModel"
        Title="Exclude Stats"
        Width="380" Height="560"
        MinWidth="320" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackgroundBrush}"
        BorderBrush="{DynamicResource ThemeBorderBrush}"
        BorderThickness="1">

    <!-- §126: two lists in one window, because both answer the same
         question - what do I want to see on the main form. They are persisted
         under separate keys and applied by separate methods; only the dialog
         is shared. The whole thing scrolls now: two lists plus the master
         checkbox no longer fit the fixed height the stats list alone did. -->
    <!-- §188: the content sits on a themedPanel so it reads off a surface
         rather than off the background image. The panel follows the Stats
         Background colour and is invisible until that colour is set - no
         fill, no outline, no inset. Its child is deliberately not
         re-indented. See App.axaml. -->
    <Border Classes="themedPanel">
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

        <TextBlock Grid.Row="0"
                   Text="Choose what to hide from the main window. Everything hidden keeps counting in the background - it is just not shown."
                   TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,0,0,12" />

        <CheckBox Grid.Row="1" Content="Hide the entire stats panel"
                  IsChecked="{Binding HideEntireStatsPanel, Mode=TwoWay}"
                  Foreground="{DynamicResource ThemeTextBrush}" FontWeight="Bold" />

        <TextBlock Grid.Row="2"
                   Text="This also hides the Since Form pause control and the Report a Problem and swap buttons at the foot of the panel, not just the stats below. Report a Problem moves back beside Announcements while it is hidden."
                   TextWrapping="Wrap" FontStyle="Italic" FontSize="11"
                   Foreground="{DynamicResource ThemeTextBrush}" Margin="0,2,0,12" />

        <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Stats panel" FontWeight="Bold" Margin="0,0,0,4"
                           Foreground="{DynamicResource ThemeTextBrush}" />

                <ItemsControl ItemsSource="{Binding Stats}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StatToggleOption">
                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsExcluded, Mode=TwoWay}"
                                      Foreground="{DynamicResource ThemeTextBrush}" Margin="0,4,0,4" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Separator Margin="0,10,0,10" />

                <TextBlock Text="Encounter table columns" FontWeight="Bold" Margin="0,0,0,4"
                           Foreground="{DynamicResource ThemeTextBrush}" />

                <TextBlock Text="The Pokémon name is always shown - a row without it is a row of numbers about nothing."
                           TextWrapping="Wrap" FontStyle="Italic" FontSize="11"
                           Foreground="{DynamicResource ThemeTextBrush}" Margin="0,0,0,6" />

                <ItemsControl ItemsSource="{Binding TableColumns}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StatToggleOption">
                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsExcluded, Mode=TwoWay}"
                                      Foreground="{DynamicResource ThemeTextBrush}" Margin="0,4,0,4" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="4" Text="{Binding SaveError}" Foreground="{DynamicResource ThemeErrorBrush}" TextWrapping="Wrap"
                   IsVisible="{Binding HasSaveError}" Margin="0,8,0,8" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Save" Command="{Binding SaveCommand}" />
            <Button Content="Cancel" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
    </Border>
</Window>
