<!-- §397. One region's Spawns page: the maps the admin filed under it, as
     links, alphabetical. The row is the link - a name is a short word and a
     row is easy to aim at, the same shape the Search and Previously Battled
     lists use. The status line says whether the list is fresh from the
     events server or the copy this machine kept. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Foot_Tracker.ViewModels"
        x:Class="Foot_Tracker.Views.SpawnRegionWindow"
        x:DataType="vm:SpawnRegionViewModel"
        Title="{Binding Title}"
        Width="460" Height="520"
        MinWidth="360" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackgroundBrush}"
        BorderBrush="{DynamicResource ThemeBorderBrush}"
        BorderThickness="1">

    <Window.Styles>
        <!-- A transparent fill so the whole row takes the click, set in a
             style rather than on the element so the hover fill below can
             replace it (a local value would beat a style setter). -->
        <Style Selector="Border.mapLink">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.mapLink:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeTableHeaderBrush}" />
        </Style>
    </Window.Styles>

    <Border Classes="themedPanel">
    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto,Auto">

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource ThemeTextBrush}" Margin="0,0,0,4" />

        <TextBlock Grid.Row="1" Text="Click a map to see what spawns there, how, and when."
                   TextWrapping="Wrap" Opacity="0.8" FontSize="12"
                   Foreground="{DynamicResource ThemeTextBrush}" Margin="0,0,0,10" />

        <ScrollViewer Grid.Row="2">
            <StackPanel>
                <TextBlock Text="{Binding EmptyMessage}" TextWrapping="Wrap"
                           Foreground="{DynamicResource ThemeTextBrush}"
                           IsVisible="{Binding !HasMaps}" Margin="0,8,0,0" />

                <ItemsControl ItemsSource="{Binding Maps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SpawnMapLink">
                            <Border Classes="mapLink" Cursor="Hand"
                                    Padding="8,6" CornerRadius="3" Margin="0,0,0,2"
                                    ToolTip.Tip="Open this map's spawns"
                                    PointerPressed="MapRow_PointerPressed">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Map}" FontWeight="Bold"
                                               TextDecorations="Underline" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ThemeTextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="11" Opacity="0.75"
                                               VerticalAlignment="Center" Margin="12,0,0,0"
                                               Foreground="{DynamicResource ThemeTextBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                   Foreground="{DynamicResource ThemeTextBrush}" Margin="0,10,0,0" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Refresh" Click="RefreshButton_Click" IsEnabled="{Binding !IsRefreshing}" />
            <Button Content="Close" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
    </Border>
</Window>
