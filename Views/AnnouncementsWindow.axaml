<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Foot_Tracker.ViewModels"
        x:Class="Foot_Tracker.Views.AnnouncementsWindow"
        x:DataType="vm:AnnouncementsViewModel"
        Title="Announcements"
        Width="560" Height="620"
        MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackgroundBrush}"
        BorderBrush="{DynamicResource ThemeBorderBrush}"
        BorderThickness="1">

    <!-- §238: no whole-window themedPanel. The posts are the panels, the way
         BossDetailWindow's cards are; a panel inside a panel is two surfaces
         of one colour. -->
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <TextBlock Grid.Row="0" Text="Announcements" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource ThemeTextBrush}" Margin="0,0,0,4" />

        <TextBlock Grid.Row="1"
                   Text="What PRO announced in their own Discord - maintenance, PvP changes, Trade Zone updates and when the World Quest starts. Read by the events server and passed on here."
                   TextWrapping="Wrap" FontSize="11" Opacity="0.75"
                   Foreground="{DynamicResource ThemeTextBrush}" Margin="0,0,0,8" />

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource ThemeTextBrush}" Margin="0,0,0,10" />

        <ScrollViewer Grid.Row="3">
            <ItemsControl ItemsSource="{Binding Announcements}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AnnouncementRow">
                        <Border Classes="themedPanel" Margin="0,0,0,10" Padding="12"
                                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                                CornerRadius="4">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding PublishedDisplay}" FontSize="11" Opacity="0.7" />
                                <TextBlock Text="{Binding Body}" TextWrapping="Wrap" FontSize="12"
                                           Margin="0,4,0,0" />
                                <!-- Only present when the post carried one the
                                     Worker and the client both agreed to fetch. -->
                                <Image Source="{Binding Image}" Stretch="Uniform"
                                       HorizontalAlignment="Left" MaxHeight="96" Margin="0,6,0,0"
                                       IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Refresh" Command="{Binding RefreshCommand}" />
            <Button Content="Close" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
