<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Foot_Tracker.ViewModels"
        x:Class="Foot_Tracker.Views.WorldQuestCalculatorWindow"
        x:DataType="vm:WorldQuestCalculatorViewModel"
        Title="World Quest Calculator"
        Width="620" Height="660"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackgroundBrush}"
        BorderBrush="{DynamicResource ThemeBorderBrush}"
        BorderThickness="1">

    <!-- §188: the content sits on a themedPanel so it reads off a surface
         rather than off the background image. The panel follows the Stats
         Background colour and is invisible until that colour is set - no
         fill, no outline, no inset. Its child is deliberately not
         re-indented. See App.axaml. -->
    <Border Classes="themedPanel">
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="World Quest Calculator" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource ThemeTextBrush}" />
            <TextBlock Text="Every Pokémon you submit contributes the sum of its six IVs to the community goal. Contribute at least 0.5% of the goal yourself for a Mysterious Ticket - 3% earns a second one. Add each catch below (or just its total) to see how far you are."
                       TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                       Foreground="{DynamicResource ThemeTextBrush}" Margin="0,2,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,110,*" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Text="Community goal" VerticalAlignment="Center"
                       Foreground="{DynamicResource ThemeTextBrush}" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" MinWidth="0" Text="{Binding GoalText}" />
            <TextBlock Grid.Column="2" Text="(150,000 in recent runs)" FontSize="11" Opacity="0.7"
                       VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextBrush}" Margin="8,0,0,0" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button Content="Add a catch (enter IVs)" Command="{Binding AddSubmissionCommand}" />
            <TextBox Width="80" MinWidth="0" PlaceholderText="IV total" Text="{Binding QuickTotalText}" />
            <Button Content="Add as total" Command="{Binding AddQuickTotalCommand}" />
        </StackPanel>

        <!-- One row per submitted catch. ItemsControl rather than ListBox: the
             rows hold TextBoxes, and selection chrome would just fight the
             editing focus. -->
        <ScrollViewer Grid.Row="3">
            <ItemsControl ItemsSource="{Binding Submissions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WqSubmissionRow">
                        <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1"
                                Padding="0,4,0,4">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4"
                                            IsVisible="{Binding !IsDirect}">
                                    <TextBox Width="46" MinWidth="0" PlaceholderText="HP" Text="{Binding HpText}" />
                                    <TextBox Width="46" MinWidth="0" PlaceholderText="Atk" Text="{Binding AttackText}" />
                                    <TextBox Width="46" MinWidth="0" PlaceholderText="Def" Text="{Binding DefenseText}" />
                                    <TextBox Width="46" MinWidth="0" PlaceholderText="SpA" Text="{Binding SpAttackText}" />
                                    <TextBox Width="46" MinWidth="0" PlaceholderText="SpD" Text="{Binding SpDefenseText}" />
                                    <TextBox Width="46" MinWidth="0" PlaceholderText="Spe" Text="{Binding SpeedText}" />
                                </StackPanel>
                                <TextBlock Grid.Column="0" Text="Entered as a total" FontSize="11" Opacity="0.7"
                                           VerticalAlignment="Center" IsVisible="{Binding IsDirect}"
                                           Foreground="{DynamicResource ThemeTextBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding TotalDisplay}" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="10,0"
                                           Foreground="{DynamicResource ThemeTextBrush}" />
                                <Button Grid.Column="2" Content="Remove"
                                        Command="{Binding $parent[Window].((vm:WorldQuestCalculatorViewModel)DataContext).RemoveSubmissionCommand}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="4" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                CornerRadius="4" Padding="10" Margin="0,10,0,0">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding CountLine}" FontWeight="Bold"
                           Foreground="{DynamicResource ThemeTextBrush}" />
                <TextBlock Text="{Binding ShareLine}" TextWrapping="Wrap"
                           Foreground="{DynamicResource ThemeTextBrush}" />
                <TextBlock Text="{Binding AverageLine}" TextWrapping="Wrap"
                           Foreground="{DynamicResource ThemeTextBrush}" />
                <TextBlock Text="{Binding TicketOneLine}" TextWrapping="Wrap"
                           Foreground="{DynamicResource ThemeTextBrush}" />
                <TextBlock Text="{Binding TicketTwoLine}" TextWrapping="Wrap"
                           Foreground="{DynamicResource ThemeTextBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="5" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{DynamicResource ThemeErrorBrush}"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button Grid.Column="1" Content="Close" Click="CloseButton_Click" />
        </Grid>
    </Grid>
    </Border>
</Window>
