<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Foot_Tracker.ViewModels"
        x:Class="Foot_Tracker.Views.EventsWindow"
        x:DataType="vm:EventsViewModel"
        Title="Events"
        Width="535" Height="640" MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackgroundBrush}">

    <!-- §103 built this to the Events reference design - an underlined Events
         heading, then full cards: underlined title, type, the message in its
         own bordered box, a Rewards box (item / Pokémon / Pokédollars, with
         the reward's sprite) beside the post's subject sprite, and the
         "Posted by ... - 2d ago" line bottom-right.
         §106 removed the "Community events (Max 2)" strip that sat between
         the heading and the cards: it showed the two newest gathering-type
         posts in compact form, which meant every one of them appeared TWICE
         on screen - once in the strip and again as its own card right below.
         The cap itself was only ever about that display; nothing limits how
         many community events can be posted. -->
    <!-- §189: the panel is on the event card only. The heading, the
         Refresh row and the empty-board line stay on the window
         background; the card is the thing being read. -->
    <Grid RowDefinitions="Auto,Auto,*" Margin="16">

        <TextBlock Grid.Row="0" Text="Events" FontSize="22" FontWeight="Bold"
                   TextDecorations="Underline" Foreground="{DynamicResource ThemeTextBrush}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,6,0,6">
            <Button Content="⟳ Refresh" Command="{Binding RefreshCommand}" />
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center"
                       FontSize="11" Opacity="0.8" Foreground="{DynamicResource ThemeTextBrush}" />
        </StackPanel>

        <Grid Grid.Row="2">
            <TextBlock Text="No events posted yet." IsVisible="{Binding HasNoEvents}"
                       Foreground="{DynamicResource ThemeTextBrush}" Opacity="0.6"
                       HorizontalAlignment="Center" Margin="0,24,0,0" />

            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Board}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GuildEventCardItem">
                            <Border Classes="themedPanel"
                                    BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="2"
                                    Padding="12" Margin="0,0,0,10">
                                <Grid ColumnDefinitions="*,200" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Title}"
                                               FontWeight="Bold" FontSize="15" TextDecorations="Underline"
                                               TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextBrush}" />

                                    <!-- §106: the two actions each post carries, placed
                                         on the title row exactly as annotated. Click
                                         handlers rather than commands because both
                                         open a window, which is a View concern - the
                                         same shape every other window-opening action
                                         in this app uses. A WrapPanel so a narrow
                                         window stacks them instead of clipping.
                                         §107: each one is now on the card only if the
                                         poster left that marker filled on the Create
                                         Event form. A hidden button takes no space in
                                         the WrapPanel, so a post with neither simply
                                         has a clean title row - no greyed-out
                                         leftovers. -->
                                    <WrapPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right">
                                        <Button Content="{Binding ViewEntriesText}" FontSize="11" Padding="6,3"
                                                Margin="0,0,4,4" Click="ViewEntriesButton_Click"
                                                IsVisible="{Binding AllowViewEntries}"
                                                ToolTip.Tip="See who has submitted a Pokémon to this event." />
                                        <Button Content="Submit Pokémon" FontSize="11" Padding="6,3"
                                                Margin="0,0,0,4" Click="SubmitPokemonButton_Click"
                                                IsVisible="{Binding AllowPokemonSubmissions}"
                                                ToolTip.Tip="Submit your own Pokémon to this event, with a screenshot." />
                                    </WrapPanel>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding TypeLabel}"
                                               FontWeight="Bold" FontSize="12" Opacity="0.85" Margin="12,2,0,6"
                                               Foreground="{DynamicResource ThemeTextBrush}" />

                                    <Border Grid.Row="2" Grid.Column="0" BorderBrush="{DynamicResource ThemeBorderBrush}"
                                            BorderThickness="1" Padding="8" Margin="0,0,8,8">
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{DynamicResource ThemeTextBrush}" />
                                    </Border>

                                    <Border Grid.Row="3" Grid.Column="0" BorderBrush="{DynamicResource ThemeBorderBrush}"
                                            BorderThickness="1" Padding="8" Margin="0,0,8,0"
                                            IsVisible="{Binding HasRewards}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="Rewards" FontWeight="Bold" FontSize="13"
                                                           TextDecorations="Underline" Foreground="{DynamicResource ThemeTextBrush}" />
                                                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasItemReward}">
                                                    <TextBlock Text="Item:" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeTextBrush}" />
                                                    <TextBlock Text="{Binding ItemReward}" FontSize="12" Foreground="{DynamicResource ThemeTextBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasPokemonReward}">
                                                    <TextBlock Text="Pokémon:" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeTextBrush}" />
                                                    <TextBlock Text="{Binding PokemonRewardName}" FontSize="12" Foreground="{DynamicResource ThemeTextBrush}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasPokeDollars}">
                                                    <TextBlock Text="Pokédollars:" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeTextBrush}" />
                                                    <TextBlock Text="{Binding PokeDollarsText}" FontSize="12" Foreground="{DynamicResource ThemeTextBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2" IsVisible="{Binding HasPokemonReward}">
                                                <Image Source="{Binding PokemonRewardSprite}" Width="56" Height="56" Stretch="Uniform" />
                                                <TextBlock Text="{Binding PokemonRewardName}" FontWeight="Bold" FontSize="11"
                                                           HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Row="2" Grid.RowSpan="2" Grid.Column="1" Spacing="4"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                IsVisible="{Binding HasPokemon}">
                                        <Image Source="{Binding Sprite}" Width="96" Height="96" Stretch="Uniform" />
                                        <TextBlock Text="{Binding PokemonName}" FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextBrush}" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                               Text="{Binding PostedByLine}" FontWeight="Bold" FontSize="12"
                                               HorizontalAlignment="Right" Margin="0,8,0,0"
                                               Foreground="{DynamicResource ThemeTextBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
