<!-- §397. One map's spawn page: the species published for it, each with
     its sprite and type badges, how it is met (grass, surf, a rod), when
     (morning, day, night) and whether the area needs membership. The same
     header chips and row shape the map encounter table (§280) uses, so a
     spawn page and an encounter page read alike. §398: a Balls column - the
     community's matching balls for the species, up to three pictures, the
     shiny's named in the row's tooltip. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Foot_Tracker.ViewModels"
        xmlns:conv="using:Foot_Tracker.Converters"
        x:Class="Foot_Tracker.Views.SpawnMapWindow"
        x:DataType="vm:SpawnMapViewModel"
        Title="{Binding Title}"
        Width="620" Height="540"
        MinWidth="480" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackgroundBrush}"
        BorderBrush="{DynamicResource ThemeBorderBrush}"
        BorderThickness="1">

    <Window.Styles>
        <Style Selector="Border.tableHeader">
            <Setter Property="Background" Value="{DynamicResource ThemeTableHeaderBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style Selector="Border.tableHeader > TextBlock">
            <Setter Property="Margin" Value="6,5" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
        </Style>
    </Window.Styles>

    <Border Classes="themedPanel">
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource ThemeTextBrush}" Margin="0,0,0,4" />

        <TextBlock Grid.Row="1" Text="{Binding SummaryLine}" Opacity="0.8" TextWrapping="Wrap"
                   Foreground="{DynamicResource ThemeTextBrush}" Margin="0,0,0,10"
                   IsVisible="{Binding SummaryLine, Converter={x:Static conv:StringNotEmptyConverter.Instance}}" />

        <!-- The row template below repeats these ColumnDefinitions verbatim -
             the two stay in step by hand, as every table in this app does. -->
        <Grid Grid.Row="2" ColumnDefinitions="*,100,150,50,84" Margin="0,0,0,4"
              IsVisible="{Binding HasRows}">
            <Border Grid.Column="0" Classes="tableHeader"><TextBlock Text="Pokémon" /></Border>
            <Border Grid.Column="1" Classes="tableHeader"><TextBlock Text="How" /></Border>
            <Border Grid.Column="2" Classes="tableHeader"><TextBlock Text="When" /></Border>
            <Border Grid.Column="3" Classes="tableHeader"><TextBlock Text="MS" ToolTip.Tip="Needs membership" /></Border>
            <Border Grid.Column="4" Classes="tableHeader">
                <TextBlock Text="Balls"
                           ToolTip.Tip="Poké Balls that match the Pokémon's colours, from the community's Legal Matching Pokéballs list - up to three for the ordinary colouring. Hover a row for the names, and the shiny's." />
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding EmptyMessage}" TextWrapping="Wrap"
                   Foreground="{DynamicResource ThemeTextBrush}" VerticalAlignment="Top"
                   IsVisible="{Binding !HasRows}" />

        <ListBox Grid.Row="3" ItemsSource="{Binding Rows}"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 IsVisible="{Binding HasRows}">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0,3" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SpawnPokemonRow">
                    <Grid ColumnDefinitions="*,100,150,50,84">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="4,0">
                            <Image Source="{Binding Sprite}" Width="32" Height="32" Stretch="Uniform"
                                   RenderOptions.BitmapInterpolationMode="None" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="Bold"
                                       Foreground="{DynamicResource ThemeTextBrush}" />
                            <Image Source="{Binding TypeIcon1}" Width="18" Height="18" Stretch="Uniform"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding TypeIcon1, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <Image Source="{Binding TypeIcon2}" Width="18" Height="18" Stretch="Uniform"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding TypeIcon2, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding MethodText}" TextAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextBrush}" />
                        <TextBlock Grid.Column="2" Text="{Binding TimeText}" TextAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextBrush}" />
                        <TextBlock Grid.Column="3" Text="{Binding MembersText}" TextAlignment="Center" FontWeight="Bold"
                                   VerticalAlignment="Center" Foreground="{DynamicResource ThemeWarningBrush}"
                                   ToolTip.Tip="Needs membership" IsVisible="{Binding MembersOnly}" />
                        <!-- §398: the pictures carry the tooltip; a species the
                             list lacks shows a dash that says so. -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="3"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    ToolTip.Tip="{Binding BallsTip}" IsVisible="{Binding HasBalls}">
                            <Image Source="{Binding BallIcon1}" Width="20" Height="20" Stretch="Uniform"
                                   IsVisible="{Binding BallIcon1, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <Image Source="{Binding BallIcon2}" Width="20" Height="20" Stretch="Uniform"
                                   IsVisible="{Binding BallIcon2, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <Image Source="{Binding BallIcon3}" Width="20" Height="20" Stretch="Uniform"
                                   IsVisible="{Binding BallIcon3, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                        <TextBlock Grid.Column="4" Text="–" Opacity="0.5" TextAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextBrush}"
                                   ToolTip.Tip="{Binding BallsTip}" IsVisible="{Binding !HasBalls}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
    </Border>
</Window>
