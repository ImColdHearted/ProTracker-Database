<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Foot_Tracker.ViewModels"
        x:Class="Foot_Tracker.Views.EventEntriesWindow"
        x:DataType="vm:EventEntriesViewModel"
        Title="Event Entries"
        Width="560" Height="480" MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackgroundBrush}">

    <!-- §106: every submission to one Events post - username, Pokémon,
         timestamp. Same DataGrid shape and sprite-plus-name Pokémon cell as
         the main window's session-encounter tables, so the two read alike.
         Clicking a row opens that entry's detail window (its screenshot). -->
    <!-- §188: the content sits on a themedPanel so it reads off a surface
         rather than off the background image. The panel follows the Stats
         Background colour and is invisible until that colour is set - no
         fill, no outline, no inset. Its child is deliberately not
         re-indented. See App.axaml. -->
    <Border Classes="themedPanel">
    <Grid RowDefinitions="Auto,Auto,*" Margin="16">

        <TextBlock Grid.Row="0" Text="{Binding EventTitle}" FontSize="17" FontWeight="Bold"
                   TextDecorations="Underline" TextWrapping="Wrap"
                   Foreground="{DynamicResource ThemeTextBrush}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,6,0,8">
            <Button Content="⟳ Refresh" Command="{Binding RefreshCommand}" />
            <TextBlock Text="{Binding SummaryText}" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource ThemeTextBrush}" Opacity="0.8" />
        </StackPanel>

        <Grid Grid.Row="2">
            <TextBlock Text="No entries submitted yet - use Submit Pokémon on the event to add one."
                       IsVisible="{Binding HasNoEntries}" TextWrapping="Wrap"
                       Foreground="{DynamicResource ThemeTextBrush}" Opacity="0.6"
                       HorizontalAlignment="Center" Margin="0,24,0,0" />

            <DataGrid ItemsSource="{Binding Entries}"
                      IsVisible="{Binding !HasNoEntries}"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      GridLinesVisibility="Horizontal"
                      Background="{DynamicResource ThemeEncountersBackgroundBrush}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Username" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:EventEntryRow">
                                <TextBlock Text="{Binding Username}" VerticalAlignment="Center"
                                           Cursor="Hand" PointerPressed="EntryRow_PointerPressed"
                                           ToolTip.Tip="Click to see this entry's screenshot"
                                           Foreground="{DynamicResource ThemeTextBrush}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Pokémon" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:EventEntryRow">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                            Cursor="Hand" PointerPressed="EntryRow_PointerPressed"
                                            ToolTip.Tip="Click to see this entry's screenshot">
                                    <Image Source="{Binding Sprite}" Width="26" Height="26" Stretch="Uniform" />
                                    <TextBlock Text="{Binding PokemonName}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ThemeTextBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Submitted" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:EventEntryRow">
                                <TextBlock Text="{Binding SubmittedText}" VerticalAlignment="Center"
                                           Cursor="Hand" PointerPressed="EntryRow_PointerPressed"
                                           ToolTip.Tip="Click to see this entry's screenshot"
                                           Foreground="{DynamicResource ThemeTextBrush}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
    </Border>
</Window>
