<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Foot_Tracker.ViewModels"
        xmlns:conv="using:Foot_Tracker.Converters"
        x:Class="Foot_Tracker.Views.PokemonSelectorWindow"
        x:DataType="vm:PokemonSelectorViewModel"
        Title="Select Pokémon (up to 4)"
        Width="790" Height="660"
        MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackgroundBrush}">

    <Window.Styles>
        <!-- Bright, theme-independent highlight for selected cards - matches the
             app's existing cyan accent color used for links elsewhere. -->
        <Style Selector="Border.selected">
            <Setter Property="BorderBrush" Value="#42C8FF" />
            <Setter Property="BorderThickness" Value="3" />
        </Style>
    </Window.Styles>

    <!-- §196: the panel moves off the window and onto the cards, the same
         correction sections 189 and 195 made everywhere else. One panel over
         the whole grid made the page a single dark sheet with the window's
         own background showing only at its edges; a panel per card makes each
         Pokemon a dark tile with that background running between them, which
         is what it should have looked like all along. -->
    <!-- §219: two columns. The result grid is pinned to a width that holds
         exactly five cards - five times 116 is 580, and the column is 592 so
         a stray pixel of padding cannot drop it to four - and the forms panel
         moved out of a strip underneath and into the column beside it.
         Underneath, it covered the third and fourth rows of results the
         moment anything was clicked. Beside them, it covers nothing. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="592,*" Margin="16">

        <TextBox Grid.Row="0" Grid.ColumnSpan="2" PlaceholderText="Search Pokémon…" Text="{Binding SearchText}" Margin="0,0,0,8" />

        <!-- §362: the instruction had to change with the interaction. A grid
             click used to add a target; now it opens that Pokemon's cards on
             the right, and every slot - the ordinary sprite included - is
             added from there. -->
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Click a Pokémon to see its sprites, then click one on the right to hunt it - up to 4, and 3 of any one Pokémon. Click a chosen sprite again to drop it."
                   Foreground="{DynamicResource ThemeTextBrush}" Opacity="0.7" Margin="0,0,0,8" />

        <!-- Search result cards: replaces flpPokemon FlowLayoutPanel + CreatePokemonCard/CreateRegionalPokemonCard -->
        <ScrollViewer Grid.Row="2" Grid.Column="0">
            <ItemsControl ItemsSource="{Binding SearchResults}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PokemonCardItem">
                        <!-- Height bumped 120->136 to fit the new type-icon row below the name
                             without clipping against this Border's fixed size. -->
                        <Border Width="100" Height="136" Margin="8" Padding="4"
                                Classes="themedPanel"
                                BorderThickness="2" CornerRadius="4"
                                Cursor="Hand"
                                Classes.selected="{Binding IsSelected}">
                            <StackPanel>
                                <Image Source="{Binding Sprite}" Width="80" Height="80" Stretch="Uniform"
                                       PointerPressed="Card_PointerPressed"
                                       DoubleTapped="Card_DoubleTapped" />
                                <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap"
                                           PointerPressed="Card_PointerPressed" DoubleTapped="Card_DoubleTapped" />
                                <!-- Empty for alternate forms/counterparts (no type data for those -
                                     see PokemonLibraryEntry.Types remarks); shows normally for species. -->
                                <ItemsControl ItemsSource="{Binding Types}" HorizontalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Image Source="{Binding Converter={x:Static conv:TypeIconConverter.Instance}}" Width="20" Height="20" Stretch="Uniform" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Inline forms/counterparts panel: replaces the separate PokemonFormsPopup
             window. Cards sized to match the original standalone popup (96px
             sprites) rather than the more compact 64px this was shrunk to when
             folded inline - at 64px, event recolors with busier art (shinies,
             seasonal variants) were hard to make out.

             §219: now a full height column on the right rather than a capped
             strip along the bottom, so the MaxHeight that used to stop a row
             of the larger cards being clipped is gone - the column has the
             whole window to scroll in. -->
        <Border Grid.Row="2" Grid.Column="1"
                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1,0,0,0"
                Margin="8,0,0,0" Padding="8,0,0,0">
            <!-- §272: the column is a picker now, not a display. Its cards
                 were listed and inert - the event skins sat right there and a
                 click did nothing. A header says what a click does and a line
                 under it says what the last one did; the message is separate
                 from StatusMessage below because that one is drawn in the
                 error brush. -->
            <DockPanel IsVisible="{Binding HasForms}">
                <TextBlock DockPanel.Dock="Top"
                           Text="Click a sprite to hunt this Pokémon with it - click it again to stop."
                           Foreground="{DynamicResource ThemeTextBrush}" Opacity="0.55"
                           FontSize="11" TextWrapping="Wrap" Margin="4,0,4,4" />
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding SkinMessage}"
                           Foreground="{DynamicResource ThemeTextBrush}"
                           FontSize="11" TextWrapping="Wrap" Margin="4,4,4,0" />
                <ScrollViewer>
                <ItemsControl ItemsSource="{Binding AvailableForms}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PokemonCardItem">
                            <!-- Height bumped 148->164 to fit the new type-icon row without
                                 clipping against this Border's fixed size. -->
                            <!-- The same .selected outline the search grid uses,
                                 here marking the sprite this target is ALREADY
                                 drawn with rather than a picked target. -->
                            <Border Width="116" Height="164" Margin="4" Classes="themedPanel"
                                    BorderThickness="2" CornerRadius="4" Cursor="Hand"
                                    Classes.selected="{Binding IsSelected}"
                                    PointerPressed="FormCard_PointerPressed">
                                <StackPanel>
                                    <Image Source="{Binding Sprite}" Width="96" Height="96" Stretch="Uniform" />
                                    <TextBlock Text="{Binding Tag, StringFormat=[{0}]}" FontSize="10" TextAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" />
                                    <!-- Empty for regional forms/Mega/G-Max/counterparts (no type data
                                         for those - see PokemonLibraryEntry.Types remarks); shows
                                         normally for the "Normal" entry, which resolves via species data. -->
                                    <ItemsControl ItemsSource="{Binding Types}" HorizontalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Image Source="{Binding Converter={x:Static conv:TypeIconConverter.Instance}}" Width="20" Height="20" Stretch="Uniform" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- §219: the column stands there from the moment the window opens,
             so it says what it is for while it is empty. LoadForms always
             adds at least one entry, so this shows only before the first
             click. Same cell as the Border above; the two are never both
             visible. -->
        <TextBlock Grid.Row="2" Grid.Column="1"
                   Text="Click a sprite to see its forms and event skins here."
                   IsVisible="{Binding !HasForms}"
                   Foreground="{DynamicResource ThemeTextBrush}" Opacity="0.55"
                   FontSize="11" TextWrapping="Wrap"
                   Margin="20,4,4,0" VerticalAlignment="Top" />

        <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,8,0,0">
            <TextBlock Grid.Column="0" Text="{Binding SelectedCards.Count, StringFormat='{}{0}/4 selected'}"
                       Foreground="{DynamicResource ThemeTextBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="{DynamicResource ThemeErrorBrush}" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Select" Command="{Binding SelectCommand}" Margin="0,0,8,0" />
            <Button Grid.Column="3" Content="Cancel" Click="CancelButton_Click" />
        </Grid>
    </Grid>
</Window>
