<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Foot_Tracker.Views.ExportFormatDialogWindow"
        Title="Export Format"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackgroundBrush}"
        CanResize="False">

    <!-- §188: the content sits on a themedPanel so it reads off a surface
         rather than off the background image. The panel follows the Stats
         Background colour and is invisible until that colour is set - no
         fill, no outline, no inset. Its child is deliberately not
         re-indented. See App.axaml. -->
    <Border Classes="themedPanel">
    <StackPanel Margin="20" Spacing="16">
        <TextBlock Text="Choose a format to export to:" TextWrapping="Wrap"
                   Foreground="{DynamicResource ThemeTextBrush}" />

        <StackPanel Orientation="Horizontal" Spacing="40">
            <RadioButton Name="CsvRadioButton" GroupName="ExportFormat" Content="CSV" IsChecked="True" />
            <RadioButton Name="JsonRadioButton" GroupName="ExportFormat" Content="JSON" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="15">
            <Button Content="Export" Click="ExportButton_Click" />
            <Button Content="Cancel" Click="CancelButton_Click" />
        </StackPanel>
    </StackPanel>
    </Border>
</Window>
