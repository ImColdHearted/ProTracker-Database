<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Foot_Tracker.ViewModels"
        x:Class="Foot_Tracker.Views.BossListWindow"
        x:DataType="vm:BossListViewModel"
        Title="Boss Database"
        Width="420" Height="520"
        MinWidth="320" MinHeight="380"
        Background="{DynamicResource ThemeBackgroundBrush}">

    <!-- §188: the content sits on a themedPanel so it reads off a surface
         rather than off the background image. The panel follows the Stats
         Background colour and is invisible until that colour is set - no
         fill, no outline, no inset. Its child is deliberately not
         re-indented. See App.axaml. -->
    <Border Classes="themedPanel">
    <Grid RowDefinitions="*,Auto,Auto" Margin="12">
        <ListBox Grid.Row="0" ItemsSource="{Binding Bosses}" SelectedItem="{Binding SelectedBoss}"
                 DoubleTapped="BossList_DoubleTapped">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:BossListItem">
                    <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ComboBox Grid.Row="1" Margin="0,8" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding DifficultyOptions}"
                  SelectedItem="{Binding SelectedDifficulty}" />

        <Button Grid.Row="2" Content="Open Boss" Command="{Binding OpenCommand}" HorizontalAlignment="Right" />
    </Grid>
    </Border>
</Window>
