<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Foot_Tracker.ViewModels"
        xmlns:conv="using:Foot_Tracker.Converters"
        x:Class="Foot_Tracker.Views.CounterpartsWindow"
        x:DataType="vm:CounterpartsViewModel"
        Title="{Binding GroupTitle}"
        Width="755" Height="640"
        MinWidth="520" MinHeight="440"
        Background="{DynamicResource ThemeBackgroundBrush}">

    <!-- §196: the panel moves off the window and onto the cards, the same
         correction sections 189 and 195 made everywhere else. One panel over
         the whole grid made the page a single dark sheet with the window's
         own background showing only at its edges; a panel per card makes each
         Pokemon a dark tile with that background running between them, which
         is what it should have looked like all along. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12">
        <TextBlock Grid.Row="0" Text="{Binding GroupTitle}" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource ThemeTextBrush}" Margin="0,0,0,8" />

        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Foreground="{DynamicResource ThemeErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />

        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CounterpartCardItem">
                        <!-- Height bumped 165->182 to fit the new type-icon row below the name
                             without clipping against this Border's fixed size, then
                             182->186 in §196 to absorb the outline that section added:
                             a 1px border takes 2px of inner height, and this box was
                             already sized to the pixel.

                             §196: the outline and the fill are both new. This was a bare
                             hit target with no chrome at all, which is why the grid read
                             as one sheet rather than as cards. -->
                        <Border Width="130" Height="186" Margin="8"
                                Classes="themedPanel"
                                BorderBrush="{DynamicResource ThemeBorderBrush}"
                                BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <Image Source="{Binding Sprite}" Width="120" Height="120" Stretch="Uniform" />
                                <TextBlock> </TextBlock>
                                <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock> </TextBlock>
                                <ItemsControl ItemsSource="{Binding Types}" HorizontalAlignment="Center" >
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Image Source="{Binding Converter={x:Static conv:TypeIconConverter.Instance}}" Width="20" Height="20" Stretch="Uniform" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
