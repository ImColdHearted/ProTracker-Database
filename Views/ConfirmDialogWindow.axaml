<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Foot_Tracker.Views.ConfirmDialogWindow"
        Title="Confirm"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackgroundBrush}"
        CanResize="False">

    <!-- §188: the content sits on a themedPanel so it reads off a surface
         rather than off the background image. The panel follows the Stats
         Background colour and is invisible until that colour is set - no
         fill, no outline, no inset. Its child is deliberately not
         re-indented. See App.axaml. -->
    <Border Classes="themedPanel">
    <StackPanel Margin="20" Spacing="16">
        <TextBlock Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextBrush}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <!-- §275: the same window answers a plain notice. The two
                 buttons are named so NotifyAsync can relabel Yes to OK and
                 hide No - one themed dialog shell rather than a second
                 window that would have to be kept in step with this one. -->
            <Button Name="YesButton" Content="Yes" Click="YesButton_Click" />
            <Button Name="NoButton" Content="No" Click="NoButton_Click" />
        </StackPanel>
    </StackPanel>
    </Border>
</Window>
