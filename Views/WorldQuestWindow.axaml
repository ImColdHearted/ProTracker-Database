<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Foot_Tracker.ViewModels"
        x:Class="Foot_Tracker.Views.WorldQuestWindow"
        x:DataType="vm:WorldQuestViewModel"
        Title="World Quest"
        Width="620" Height="430"
        MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackgroundBrush}"
        BorderBrush="{DynamicResource ThemeBorderBrush}"
        BorderThickness="1">

    <Window.Styles>
        <!-- §235: the four figures are the whole window, so they share one
             shape - an underlined heading, the number, and a caption saying
             what the number is measured against. The caption matters more
             here than it usually would: all four re-aim at the second ticket
             the moment the first is earned, and a figure that changed target
             without saying so would read as a figure that changed value. -->
        <!-- §238: none of these name a colour. The figures sit inside
             themedPanel boxes, and App.axaml's §208 rule gives every TextBlock
             in a themed panel the user's Font Color. A setter here would be
             applied after the application's and quietly outrank it, which is
             how a window ends up not following a theme everything else does. -->
        <Style Selector="TextBlock.figureHeading">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextDecorations" Value="Underline" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.figureValue">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style Selector="TextBlock.figureCaption">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Styles>

    <!-- §238: no whole-window themedPanel, unlike the §188 dialogs. The two
         figure boxes are the panels, the way BossDetailWindow's cards are; a
         panel inside a panel is two surfaces of one colour. -->
    <Grid Margin="14" RowDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- Title, and the countdown in the top right. It runs off the end
             time the events server DERIVED from the announcement's duration,
             not off the date the announcement prints - that date is stale.
             The line underneath says why the number is a maximum: a quest
             also ends the moment the community goal is met, and the tracker
             only ever knows this player's own contribution. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="World Quest" FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource ThemeTextBrush}" />
            <TextBlock Grid.Column="1" Text="{Binding CountdownText}" FontSize="22" FontWeight="Bold"
                       VerticalAlignment="Center" HorizontalAlignment="Right"
                       Foreground="{DynamicResource ThemeTextBrush}" />
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding EndsText}" FontSize="11" Opacity="0.7"
                   TextWrapping="Wrap" Margin="0,2,0,0"
                   Foreground="{DynamicResource ThemeTextBrush}" />

        <!-- What is left, the Pokemon, and what has been done. Hidden
             entirely when no quest is running, so the window never shows a
             frame of dashes. -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,*" Margin="0,12,0,0"
              IsVisible="{Binding HasQuest}">

            <Border Grid.Column="0" Classes="themedPanel"
                    BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="10,12">
                <StackPanel VerticalAlignment="Center" Spacing="14">
                    <StackPanel>
                        <TextBlock Classes="figureHeading" Text="IV's Needed" />
                        <TextBlock Classes="figureValue" Text="{Binding IvsNeededText}" />
                        <TextBlock Classes="figureCaption" Text="{Binding IvsNeededCaption}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Classes="figureHeading" Text="Average Submissions" />
                        <TextBlock Classes="figureValue" Text="{Binding AverageSubmissionsText}" />
                        <TextBlock Classes="figureCaption" Text="{Binding AverageSubmissionsCaption}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" Width="150" Margin="10,0">
                <TextBlock Text="{Binding PokemonName}" FontSize="15" FontWeight="Bold"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource ThemeTextBrush}" />
                <Border Classes="huntingSprite" Margin="0,4,0,0" Height="150"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                        CornerRadius="4">
                    <Image Source="{Binding Sprite}" Stretch="Uniform" Margin="8" />
                </Border>
            </StackPanel>

            <Border Grid.Column="2" Classes="themedPanel"
                    BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="10,12">
                <StackPanel VerticalAlignment="Center" Spacing="14">
                    <StackPanel>
                        <TextBlock Classes="figureHeading" Text="IV's Obtained" />
                        <TextBlock Classes="figureValue" Text="{Binding ObtainedText}" />
                        <TextBlock Classes="figureCaption" Text="{Binding ObtainedCaption}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Classes="figureHeading" Text="Current %" />
                        <TextBlock Classes="figureValue" Text="{Binding CurrentPercentText}" />
                        <TextBlock Classes="figureCaption" Text="{Binding CurrentPercentCaption}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,12,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource ThemeTextBrush}" />

        <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,10,0,0">
            <TextBox Grid.Column="0" Width="90" MinWidth="0" Watermark="IV total"
                     IsVisible="{Binding HasQuest}" Text="{Binding ManualTotalText}" />
            <Button Grid.Column="1" Content="Submit Pokémon" Margin="8,0,0,0"
                    IsVisible="{Binding HasQuest}" Command="{Binding SubmitPokemonCommand}"
                    ToolTip.Tip="Adds a catch you read off the panel yourself. Always available - use it whenever a catch is not detected." />
            <Button Grid.Column="2" Content="Remove Last" Margin="8,0,0,0"
                    IsVisible="{Binding HasQuest}" Command="{Binding RemoveLastCommand}"
                    ToolTip.Tip="Undoes the most recent catch, automatic or manual. It says which one it took." />
            <Button Grid.Column="4" Content="Close" Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>
