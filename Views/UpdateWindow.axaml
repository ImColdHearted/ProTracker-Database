<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Foot_Tracker.Views.UpdateWindow"
        Title="Update available"
        Width="560" Height="430" MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackgroundBrush}">

    <!-- §369. What the green Update item opens.

         It says what is about to happen before it happens, in the middle
         block below, because this is the one window in the app that closes
         the tracker and replaces the folder it is running from. Somebody
         who does not want that should be able to tell from reading, not
         from trying it. -->
    <Grid Margin="16" RowDefinitions="Auto,*,Auto,Auto,Auto">

        <StackPanel Grid.Row="0" Spacing="3" Margin="0,0,0,12">
            <TextBlock x:Name="HeadlineText" FontSize="17" FontWeight="Bold"
                       Foreground="{DynamicResource ThemeTextBrush}" />
            <TextBlock x:Name="SubText" FontSize="12" Opacity="0.75"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource ThemeTextBrush}" />
        </StackPanel>

        <Border Grid.Row="1" CornerRadius="6" Padding="10"
                Background="{DynamicResource ThemeStatsBackgroundBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap"
                           Foreground="{DynamicResource ThemeTextBrush}" />
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="2" Margin="0,10,0,0" FontSize="11" Opacity="0.7"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource ThemeTextBrush}"
                   Text="Update now downloads the new build, closes the tracker, replaces the files in its folder and opens it again. Your hunts, settings and appearance are kept - they live outside this folder. Finish or stop a hunt first if one is running." />

        <StackPanel Grid.Row="3" Spacing="4" Margin="0,10,0,0">
            <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Height="6"
                         IsVisible="False" />
            <TextBlock x:Name="StatusText" FontSize="11" Opacity="0.8"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource ThemeTextBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="UpdateNowButton" Content="Update now" Padding="20,7"
                    Click="UpdateNowButton_Click" />
            <Button x:Name="LaterButton" Content="Not now" Padding="16,7"
                    Click="LaterButton_Click" />
        </StackPanel>
    </Grid>
</Window>
