<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Foot_Tracker.ViewModels"
        x:Class="Foot_Tracker.Views.SimulatorImportWindow"
        x:DataType="vm:SimulatorImportViewModel"
        Title="Import Pokemon from Game"
        Width="1160" Height="530"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackgroundBrush}"
        BorderBrush="{DynamicResource ThemeBorderBrush}"
        BorderThickness="1">

    <!-- §162: the screenshot importer. Left: the screenshot with the
         drag-a-box overlay. Right: source buttons, the scan, and the
         parsed preview the Add button confirms. -->
    <!-- §195: the panels are on the boxes that hold something, not around
         the whole window - the same correction sections 189 made to Boss
         Cooldowns, Events and the boss template. One panel over everything
         turned this window into a single flat sheet with its own boxes
         invisible inside it. Every Border below that already set its own
         outline and padding keeps them: those are local values and a local
         value beats a style setter, so only the fill arrives from the Stats
         Background colour. -->
    <Grid Margin="10" ColumnDefinitions="*,320" RowDefinitions="Auto,*">

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource ThemeTextBrush}" Margin="0,0,0,8" />

        <Border Grid.Row="1" Grid.Column="0" Classes="themedPanel"
                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                CornerRadius="4" Padding="4" Margin="0,0,8,0">
            <Panel Name="ImagePanel" Background="Transparent">
                <TextBlock Text="No screenshot yet - capture the PRO client."
                           FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource ThemeTextBrush}"
                           IsVisible="{Binding !HasImage}" />
                <Image Name="ScreenshotImage" Source="{Binding Screenshot}" Stretch="Uniform"
                       IsVisible="{Binding HasImage}" />
                <Canvas Name="SelectionCanvas" Background="Transparent"
                        IsVisible="{Binding HasImage}">
                    <Border Name="SelectionBox" BorderBrush="#FFD54F" BorderThickness="2"
                            Background="#33FFD54F" IsVisible="False" />
                </Canvas>
            </Panel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Classes="themedPanel" Padding="8"
                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="4">
            <ScrollViewer>
                <StackPanel Spacing="8">

                    <TextBlock Text="1. Get a screenshot" FontWeight="Bold" FontSize="12"
                               Foreground="{DynamicResource ThemeTextBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Capture PRO Client" FontSize="12"
                                Command="{Binding CaptureCommand}" IsEnabled="{Binding !Busy}" />
                    </StackPanel>

                    <TextBlock Text="2. Rescan if needed" FontWeight="Bold" FontSize="12"
                               Foreground="{DynamicResource ThemeTextBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="Capturing or browsing finds and scans the card by itself. If the card was missed or misread, drag a box around it and press Scan."
                               FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                               Foreground="{DynamicResource ThemeTextBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Scan" FontWeight="Bold" FontSize="12"
                                Command="{Binding ScanCommand}" IsEnabled="{Binding !Busy}" />
                        <Button Content="Clear Box" FontSize="12" Click="ClearBox_Click"
                                IsEnabled="{Binding !Busy}" />
                    </StackPanel>
                    <TextBlock Text="{Binding SelectionText}" FontSize="11" Opacity="0.75"
                               Foreground="{DynamicResource ThemeTextBrush}" />

                    <TextBlock Text="3. Check and add" FontWeight="Bold" FontSize="12"
                               Foreground="{DynamicResource ThemeTextBrush}" Margin="0,4,0,0" />

                    <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="8" IsVisible="{Binding HasPreview}">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image Source="{Binding PreviewSprite}" Width="56" Height="56"
                                       Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"
                                       IsVisible="{Binding PreviewSprite, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock Text="{Binding PreviewHeadline}" FontWeight="Bold" FontSize="12"
                                           TextWrapping="Wrap" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ThemeTextBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding PreviewMoves}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ThemeTextBrush}" />
                            <TextBlock Text="{Binding PreviewSpread}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ThemeTextBrush}" Opacity="0.85" />
                            <TextBlock Text="{Binding PreviewNotes}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ThemeTextBrush}" Opacity="0.75" />
                        </StackPanel>
                    </Border>

                    <!-- §198: Add banks the Pokemon and leaves the window
                         open, so a whole box can be scanned in one sitting.
                         The label says "Add to Storage" once the team is
                         full, because that is where it goes. Done hands the
                         batch back to the team builder. -->
                    <Button Content="{Binding AddButtonText}" FontWeight="Bold" FontSize="12"
                            Command="{Binding ConfirmCommand}" IsEnabled="{Binding HasPreview}"
                            ToolTip.Tip="Keep this window open and carry on scanning - press Done when you have them all." />
                    <TextBlock Text="{Binding AddedSummary}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource ThemeTextBrush}" Opacity="0.8"
                               IsVisible="{Binding HasAdded}" />
                    <Button Content="Done" FontSize="12" Click="Done_Click" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
