<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Foot_Tracker.ViewModels"
        xmlns:conv="using:Foot_Tracker.Converters"
        x:Class="Foot_Tracker.Views.HuntLogSpeciesDetailWindow"
        x:DataType="vm:HuntLogSpeciesDetailViewModel"
        Title="{Binding Title}"
        Width="600" Height="520"
        MinWidth="440" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackgroundBrush}"
        BorderBrush="{DynamicResource ThemeBorderBrush}"
        BorderThickness="1">

    <!-- §220: the DataGrid equivalent of MainWindow's header chip - same
         themed fill, same one pixel border, same bold centred text. A
         DataGrid draws its own header row, so this is a style on the header
         cell rather than a Border per column. -->
    <Window.Styles>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource ThemeTableHeaderBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,5" />
        </Style>
    </Window.Styles>

    <!-- §188: the content sits on a themedPanel so it reads off a surface
         rather than off the background image. The panel follows the Stats
         Background colour and is invisible until that colour is set - no
         fill, no outline, no inset. Its child is deliberately not
         re-indented. See App.axaml. -->
    <Border Classes="themedPanel">
    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource ThemeTextBrush}" Margin="0,0,0,4" />

        <TextBlock Grid.Row="1"
                   Text="Every logged catch with this Pokémon, most recent first."
                   TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,0,0,12" />

        <Grid Grid.Row="2">
            <TextBlock Text="No catches logged for this Pokémon yet."
                       Foreground="{DynamicResource ThemeTextBrush}"
                       IsVisible="{Binding HasNoEntries}" Margin="0,8,0,0" VerticalAlignment="Top" />

            <DataGrid ItemsSource="{Binding Entries}"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      GridLinesVisibility="Horizontal"
                      Background="{DynamicResource ThemeEncountersBackgroundBrush}"
                      IsVisible="{Binding HasEntries}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Pokémon" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:HuntLogDisplayItem">
                                <!-- Width+ClipToBounds here is what actually enforces 130px - the column's
                                     own Width="130" sets the layout slot, but a DataGridTemplateColumn's
                                     cell content isn't clipped to that slot by default, so a long name plus
                                     two type icons could still visually spill past it. TextBlock.MaxWidth
                                     (58, sized for the worst case of a 2-type Pokemon: 130 - 26 sprite -
                                     12 spacing - 34 for two 16px type icons) plus TextTrimming does the
                                     graceful part - long names get a "…" instead of nothing changing - and
                                     ClipToBounds is the hard backstop for the rare case that still doesn't
                                     leave quite enough room. See MIGRATION_GUIDE.md for the earlier attempts
                                     (a plain Width="*" MaxWidth="130" on the column alone) that didn't hold. -->
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                            Width="130" ClipToBounds="True">
                                    <Image Source="{Binding Sprite}" Width="26" Height="26" Stretch="Uniform" />
                                    <TextBlock Text="{Binding PokemonName}" Foreground="{DynamicResource ThemeTextBrush}" VerticalAlignment="Center"
                                               MaxWidth="58" TextTrimming="CharacterEllipsis" />
                                    <ItemsControl ItemsSource="{Binding Types}" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Image Source="{Binding Converter={x:Static conv:TypeIconConverter.Instance}}" Width="16" Height="16" Stretch="Uniform" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Level" Binding="{Binding LevelText}" Width="75" Foreground="{DynamicResource ThemeTextBrush}" />
                    <!-- Same colored ♀/♂ header as HuntLogWindow's own Gender column -
                         see MIGRATION_GUIDE.md §77 for both the reasoning and the
                         source of these exact colors (GenderDetector's own calibrated
                         Female/Male pixel-match values). -->
                    <DataGridTextColumn Binding="{Binding GenderSymbol}" Width="85" Foreground="{DynamicResource ThemeTextBrush}">
                        <DataGridTextColumn.Header>
                            <!-- No whitespace between the TextBlock tags and the Runs -
                                 see HuntLogWindow.axaml's matching column for why. -->
                            <TextBlock><Run Text="♀" Foreground="#D9145E" /><Run Text="/" Foreground="{DynamicResource ThemeTextBrush}" /><Run Text="♂" Foreground="#08A3F4" /></TextBlock>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Map" Binding="{Binding Map}" Width="100" Foreground="{DynamicResource ThemeTextBrush}" />
                    <DataGridTextColumn Header="Encountered" Binding="{Binding EncounteredAt}" Width="*" Foreground="{DynamicResource ThemeTextBrush}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding ExportStatusMessage}"
                   Foreground="{DynamicResource ThemeTextBrush}" TextWrapping="Wrap"
                   IsVisible="{Binding ExportStatusMessage, Converter={x:Static conv:StringNotEmptyConverter.Instance}}"
                   Margin="0,8,0,0" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" Margin="0,12,0,0">
            <Button Content="Remove Previous" Command="{Binding RemovePreviousCommand}" IsEnabled="{Binding HasEntries}" />
            <Button Content="Clear All" Command="{Binding ClearAllCommand}" IsEnabled="{Binding HasEntries}" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Export…" Command="{Binding ExportCommand}" />
            <Button Content="Close" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
    </Border>
</Window>
