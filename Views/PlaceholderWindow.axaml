<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Foot_Tracker.Views.PlaceholderWindow"
        Title="Coming Soon"
        Width="500" Height="300"
        MinWidth="320" MinHeight="220"
        Background="{DynamicResource ThemeBackgroundBrush}">

    <!--
      Reusable stand-in for forms that had no real content in the original WinForms
      project either (just a sized, titled Form with a background image panel and
      no code-behind logic) - see MIGRATION_GUIDE.md for the full list.
    -->
    <!-- §188: the content sits on a themedPanel so it reads off a surface
         rather than off the background image. The panel follows the Stats
         Background colour and is invisible until that colour is set - no
         fill, no outline, no inset. Its child is deliberately not
         re-indented. See App.axaml. -->
    <Border Classes="themedPanel">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
        <TextBlock Name="TitleText" FontSize="20" FontWeight="Bold"
                   Foreground="{DynamicResource ThemeTextBrush}" HorizontalAlignment="Center" />
        <TextBlock Text="Not yet implemented." Foreground="{DynamicResource ThemeTextBrush}" HorizontalAlignment="Center" />
    </StackPanel>
    </Border>
</Window>
