<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Foot_Tracker.ViewModels"
        x:Class="Foot_Tracker.Views.ClientSelectorWindow"
        x:DataType="vm:ClientSelectorViewModel"
        Title="Assign Client"
        Width="520" Height="420" MinWidth="440" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackgroundBrush}">

    <!-- §188: the content sits on a themedPanel so it reads off a surface
         rather than off the background image. The panel follows the Stats
         Background colour and is invisible until that colour is set - no
         fill, no outline, no inset. Its child is deliberately not
         re-indented. See App.axaml. -->
    <Border Classes="themedPanel">
    <StackPanel Margin="20" Spacing="12">
        <!-- §105: every slot is pickable, including one with no PRO window
             running and one another tracker window currently holds (that one
             asks to take over first). Each client number carries its own
             session, catch logs, PVP log, boss cooldowns, appearance and stat
             preferences, so switching here switches all of that together. -->
        <TextBlock Text="Choose which client this tracker should follow. Each client keeps its own hunt data, catch logs and appearance, so you can switch between them at any time - and optionally give one a name so it's easy to tell apart from the others."
                   Foreground="{DynamicResource ThemeTextBrush}" TextWrapping="Wrap" />

        <ItemsControl ItemsSource="{Binding Slots}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ClientSlotItem">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,0,0,10">
                        <RadioButton Grid.Row="0" Grid.Column="0" GroupName="Client" Content="{Binding FoundText}"
                                     IsChecked="{Binding IsChecked}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CustomName}" Width="150"
                                 PlaceholderText="Name (optional)" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="{Binding StatusText}" IsVisible="{Binding HasStatus}"
                                   Foreground="{DynamicResource ThemeTextBrush}" Opacity="0.7"
                                   FontSize="11" TextWrapping="Wrap" Margin="24,2,0,0" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource ThemeErrorBrush}" TextWrapping="Wrap" />

        <Button Content="Assign" Command="{Binding ConfirmCommand}" HorizontalAlignment="Right" />
    </StackPanel>
    </Border>
</Window>
