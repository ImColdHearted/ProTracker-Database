<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Foot_Tracker.ViewModels"
        x:Class="Foot_Tracker.Views.ClientSelectorWindow"
        x:DataType="vm:ClientSelectorViewModel"
        Title="Assign Client"
        Width="460" Height="400" MinWidth="400" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackgroundBrush}">

    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="Multiple PRO clients were found. Choose which one this tracker should follow - and optionally give it a name so it's easy to tell apart from the others."
                   Foreground="{DynamicResource ThemeTextBrush}" TextWrapping="Wrap" />

        <ItemsControl ItemsSource="{Binding Slots}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ClientSlotItem">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <RadioButton Grid.Column="0" GroupName="Client" Content="{Binding FoundText}"
                                     IsEnabled="{Binding IsEnabled}" IsChecked="{Binding IsChecked}"
                                     VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding CustomName}" Width="150"
                                 PlaceholderText="Name (optional)" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding StatusMessage}" Foreground="OrangeRed" TextWrapping="Wrap" />

        <Button Content="Assign" Command="{Binding ConfirmCommand}" HorizontalAlignment="Right" />
    </StackPanel>
</Window>
