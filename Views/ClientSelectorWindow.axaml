<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Foot_Tracker.ViewModels"
        x:Class="Foot_Tracker.Views.ClientSelectorWindow"
        x:DataType="vm:ClientSelectorViewModel"
        Title="Assign Client"
        Width="360" Height="220"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackgroundBrush}">

    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="Multiple PRO clients were found. Choose which one this tracker should follow:"
                   Foreground="{DynamicResource ThemeTextBrush}" TextWrapping="Wrap" />

        <RadioButton GroupName="Client" Content="{Binding Client1Text}"
                     IsEnabled="{Binding Client1Enabled}" IsChecked="{Binding Client1Checked}" />
        <RadioButton GroupName="Client" Content="{Binding Client2Text}"
                     IsEnabled="{Binding Client2Enabled}" IsChecked="{Binding Client2Checked}" />

        <TextBlock Text="{Binding StatusMessage}" Foreground="OrangeRed" TextWrapping="Wrap" />

        <Button Content="Assign" Command="{Binding ConfirmCommand}" HorizontalAlignment="Right" />
    </StackPanel>
</Window>
