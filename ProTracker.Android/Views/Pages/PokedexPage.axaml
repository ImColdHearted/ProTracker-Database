<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ProTracker.Companion.ViewModels"
             xmlns:models="using:Foot_Tracker.Models"
             x:Class="ProTracker.Companion.Views.Pages.PokedexPage"
             x:DataType="vm:PokedexPageViewModel">

    <Grid RowDefinitions="Auto,*,Auto,Auto,*">
        <TextBox Grid.Row="0" Text="{Binding Query}" PlaceholderText="Pokémon…" Margin="0,0,0,6" />

        <ScrollViewer Grid.Row="1" MaxHeight="220">
            <ItemsControl ItemsSource="{Binding Species}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:PokedexEntry">
                        <Border Classes="row" PointerPressed="Species_PointerPressed">
                            <TextBlock Text="{Binding Species}" Foreground="{DynamicResource ThemeTextBrush}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="{Binding Heading}" FontSize="16" FontWeight="Bold" Margin="0,10,0,2"
                   Foreground="{DynamicResource ThemeTextBrush}" />
        <TextBlock Grid.Row="3" Text="{Binding Status}" FontSize="12" Opacity="0.8" TextWrapping="Wrap" Margin="0,0,0,6"
                   Foreground="{DynamicResource ThemeTextBrush}" />

        <ScrollViewer Grid.Row="4">
            <ItemsControl ItemsSource="{Binding Spawns}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:PokedexSpawn">
                        <!-- The Admin Console's row (§282): name, method, time,
                             and the pink MS the Pokédex itself marks members
                             areas in (§286). -->
                        <Grid ColumnDefinitions="*,80,110,34" Margin="0,3">
                            <TextBlock Grid.Column="0" Text="{Binding MapName}" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource ThemeTextBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding MethodText}" FontSize="12" TextAlignment="Center"
                                       Foreground="{DynamicResource ThemeTextBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="12" TextAlignment="Center"
                                       Foreground="{DynamicResource ThemeTextBrush}" />
                            <TextBlock Grid.Column="3" Text="MS" FontSize="12" FontWeight="Bold" TextAlignment="Center"
                                       Foreground="#FFAAFF" IsVisible="{Binding MembersOnly}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
